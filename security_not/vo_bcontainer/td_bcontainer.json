{
    "title": "BContainer",
    "id": "urn:ngsi-ld:Product:3334567",
    "description": "Thing Description of B-container",
    "base": "http://vo-bcontainer:9098/bcontainer",
    "support": "git://github.com/eclipse/thingweb.node-wot.git",
    "@context": [
        "https://www.w3.org/2019/wot/td/v1"
    ],
    "securityDefinitions": {
        "nosec_sc": {
            "scheme": "nosec"
        }
    },
    "security": "nosec_sc",
    "properties": {
        "product_model": {
            "type": "object",
            "description": "Properties defined by the product model.",
            "readOnly": true,
            "properties": {
                "modelName": {
                    "type": "string",
                    "description": "Name of the product model",
                    "value": "B-container"
                },
                "description": {
                    "type": "string",
                    "description": "Short description of the product",
                    "value": "Metal returnable and foldable container"
                },
                "usePurpose": {
                    "type": "string",
                    "description": "Use purpose of the product",
                    "value": "Transport raw materials and finished goods between manufacturing plants"
                },
                "manufacturerName": {
                    "type": "string",
                    "description": "Manufacturer company name",
                    "value": "STRUMET sp. z o.o."
                },
                "manufacturerAddress": {
                    "type": "string",
                    "description": "Manufacturer address",
                    "value": "ul. Ks. Londzina 61, 43-246 Strumien, Poland"
                },
                "taricCode": {
                    "type": "string",
                    "description": "TARIC product classification code",
                    "value": "7326901000"
                },
                "durabilityMinYears": {
                    "type": "number",
                    "description": "Minimum durability of the product in years",
                    "value": 5
                },
                "durabilityMaxYears": {
                    "type": "number",
                    "description": "Maximum durability of the product in years",
                    "value": 15
                },
                "repairability": {
                    "type": "string",
                    "description": "Indicates if the product can be repaired",
                    "value": "repairable_with_spare_parts"
                },
                "manufacturingCarbonFootprint": {
                    "type": "number",
                    "description": "Carbon footprint during manufacturing",
                    "unit": "kg CO2e",
                    "value": 427.9
                }
            }
        },
        "registered_values": {
            "type": "object",
            "description": "Properties defined by the registration.",
            "properties": {
                "partNumber": {
                    "type": "integer",
                    "description": "Part number of the product",
                    "maximum": 999999999
                },
                "manufacturingDate": {
                    "type": "string",
                    "description": "Manufacturing date of the product",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "returnRatio": {
                    "type": "number",
                    "description": "Number of foldable containers that fit inside another",
                    "minimum": 1,
                    "maximum": 10
                }
            }
        },
        "lifecycle": {
            "type": "object",
            "description": "Properties updated during product life.",
            "observable": true,
            "properties": {
                "status": {
                    "type": "string",
                    "description": "Current lifecycle stage of the product",
                    "observable": true,
                    "default": "manufactured",
                    "enum": [
                        "manufactured",
                        "in_use",
                        "maintenance",
                        "repaired",
                        "retired",
                        "recycled"
                    ]
                },
                "condition": {
                    "type": "string",
                    "description": "Physical condition of the product",
                    "observable": true,
                    "default": "new",
                    "enum": [
                        "new",
                        "good",
                        "worn",
                        "damaged",
                        "repaired"
                    ]
                },
                "currentLocation": {
                    "type": "string",
                    "description": "Current facility or warehouse location",
                    "observable": true,
                    "default": "Plant Barcelona"
                },
                "lastMaintenanceDate": {
                    "type": "string",
                    "description": "Last maintenance date of the product",
                    "observable": true,
                    "default": "",
                    "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}$"
                },
                "lifecycleCarbonFootprint": {
                    "type": "number",
                    "description": "Total carbon footprint accumulated during lifecycle",
                    "observable": true,
                    "default": 427.9,
                    "unit": "kg CO2e"
                },
                "numberOfUses": {
                    "type": "integer",
                    "description": "Number of usage cycles",
                    "observable": true,
                    "default": 0,
                    "minimum": 0
                }
            }
        }
    },
    "actions": {
        "getProductInfo": {
            "description": "Retrieves all available information about the product",
            "output": {
                "type": "object",
                "properties": {
                    "product_model": {
                        "type": "object"
                    },
                    "registered_values": {
                        "type": "object"
                    },
                    "lifecycle": {
                        "type": "object"
                    }
                }
            }
        },
        "performMaintenance": {
            "description": "Action to perform maintenance on the product",
            "input": {
                "type": "object",
                "properties": {
                    "date": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    "lifecycleCarbonFootprintIncrement": {
                        "type": "number",
                        "unit": "kg CO2e",
                        "default": 0
                    }
                },
                "required": [
                    "date"
                ]
            }
        },
        "updateLocation": {
            "description": "Action to update the current location of the product",
            "input": {
                "type": "object",
                "properties": {
                    "newLocation": {
                        "type": "string"
                    }
                },
                "required": [
                    "newLocation"
                ]
            }
        },
        "updateStatus": {
            "description": "Action to update the lifecycle status of the product",
            "input": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "enum": [
                            "manufactured",
                            "in_use",
                            "maintenance",
                            "repaired",
                            "retired",
                            "recycled"
                        ]
                    }
                },
                "required": [
                    "status"
                ]
            }
        },
        "updateCondition": {
            "description": "Action to update the physical condition of the product",
            "input": {
                "type": "object",
                "properties": {
                    "condition": {
                        "type": "string",
                        "enum": [
                            "new",
                            "good",
                            "worn",
                            "damaged",
                            "repaired"
                        ]
                    }
                },
                "required": [
                    "condition"
                ]
            }
        },
        "updateNumberOfUses": {
            "description": "Updates the number of usage cycles for the product",
            "input": {
                "type": "object",
                "properties": {
                    "numberOfUses": {
                        "type": "integer"
                    }
                }
            }
        }
    },
    "events": {
        "locationUpdated": {
            "description": "Location updated",
            "data": {
                "type": "string"
            }
        },
        "conditionUpdated": {
            "description": "Condition update",
            "data": {
                "type": "string",
                "enum": [
                    "new",
                    "good",
                    "worn",
                    "damaged",
                    "repaired"
                ]
            }
        },
        "statusUpdated": {
            "description": "Status update",
            "data": {
                "type": "string",
                "enum": [
                    "manufactured",
                    "in_use",
                    "maintenance",
                    "repaired",
                    "retired",
                    "recycled"
                ]
            }
        },
        "numberOfUsesUpdated": {
            "description": "Number of uses update from the device",
            "data": {
                "type": "integer"
            }
        },
        "lifecycleCarbonFootprintUpdated": {
            "description": "Lifecycle carbon footprint update from the device",
            "data": {
                "type": "number",
                "unit": "kg CO2e"
            }
        },
        "maintenancePerformed": {
            "description": "Maintenance performed event",
            "data": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
        }
    }
}