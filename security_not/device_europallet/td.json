{
    "title": "device",
    "id": "urn:asset:device:europallet:2224567",
    "description": "Thing Description of the Europallet device",
    "base": "http://device-europallet:9095/device",
    "securityDefinitions": {
        "nosec_sc": {
            "scheme": "nosec"
        }
    },
    "security": "nosec_sc",
    "@context": [
        "https://www.w3.org/2022/wot/td/v1.1"
    ],
    "actions": {
        "triggerLifecycleUpdate": {
            "description": "Triggers a combined update of status, location and carbon footprint",
            "input": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "enum": [
                            "manufactured",
                            "in_use",
                            "maintenance",
                            "repaired",
                            "retired",
                            "recycled"
                        ]
                    },
                    "newLocation": {
                        "type": "string"
                    },
                    "carbonFootprintIncrement": {
                        "type": "number",
                        "unit": "kg CO2e"
                    }
                },
                "required": [
                    "status",
                    "newLocation",
                    "carbonFootprintIncrement"
                ]
            }
        }
    },
    "events": {
        "damageDetected": {
            "description": "Emitted when damage is detected",
            "data": {
                "type": "object",
                "properties": {
                    "timestamp": {
                        "type": "string",
                        "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}$",
                        "description": "Time when damage was detected"
                    }
                },
                "required": [
                    "timestamp"
                ]
            }
        },
        "lifecycleChanged": {
            "description": "Emitted when status, location and carbon footprint are updated together",
            "data": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string"
                    },
                    "numberOfUses": {
                        "type": "integer"
                    },
                    "newLocation": {
                        "type": "string"
                    },
                    "carbonFootprintIncrement": {
                        "type": "number"
                    }
                }
            }
        }
    }
}