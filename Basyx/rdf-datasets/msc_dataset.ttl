scadient:suppliesTo a owl:ObjectProperty ;
    rdfs:label "supplies to" ;
    rdfs:comment "Direct supply/delivery flow from one site to another" ;
    rdfs:domain sc:Site ;
    rdfs:range sc:Site .

scadient:characteristic1_test a sc:Characteristic ;
    sc:isObservedBy scadient:sensor1_test .

scadient:characteristic2_test a sc:Characteristic ;
    sc:isObservedBy scadient:sensor2_test .

scadient:customerrequirement_test a sc:CustomerRequirement ;
    sc:satisfiesRequirement scadient:product_test .

