scadient:sensor1_test a sc:Sensor ;
    sc:observes scadient:characteristic1_test .

scadient:sensor2_test a sc:Sensor ;
    sc:observes scadient:characteristic2_test .

scadient:sensor3_test a sc:Sensor ;
    sc:observes scadient:characteristic3_test .

scadient:sensor4_test a sc:Sensor ;
    sc:observes scadient:characteristic4_test .

scadient:site_test a sc:Site ;
    sc:hasCharacteristic scadient:characteristic4_test ;
    sc:hasDevice scadient:device_test ;
    sc:hasLocation scadient:location1_test ;
    sc:performs scadient:process_test .

scadient:supplier_test a sc:Supplier ;
    sc:hasLocation scadient:location2_test ;
    sc:provides scadient:resource_test .

scadient:characteristic3_test a sc:Characteristic ;
    sc:isObservedBy scadient:sensor3_test .

scadient:characteristic4_test a sc:Characteristic ;
    sc:isObservedBy scadient:sensor4_test .

scadient:location1_test a sc:Location .

scadient:location2_test a sc:Location .

scadient:process_test a sc:Process ;
    sc:isPerformedAt scadient:site_test .

scadient:resource_test a sc:Resource ;
    sc:hasCharacteristic scadient:characteristic3_test ;
    sc:isProvidedBy scadient:supplier_test .

