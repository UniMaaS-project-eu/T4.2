@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sc: <http://unimaas-project.eu/MSCOntology#> .
@prefix scadient: <http://unimaas-project.eu/MSCOntology/data/adient/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

scadient:logisticroute_test a sc:LogisticRoute ;
    sc:hasEndingPoint scadient:location1_test ;
    sc:hasStartingPoint scadient:location2_test .

scadient:processconfiguration_test a sc:ProcessConfiguration ;
    sc:hasInput scadient:product_test ;
    sc:hasOutput scadient:product_test ;
    sc:requiresProcess scadient:process_test ;
    sc:usesResource scadient:resource_test .

scadient:siteHasResource a owl:ObjectProperty ;
    rdfs:label "site has resource" ;
    rdfs:comment "Links a Site to the Resources (e.g., containers) currently located at it, derived from DPP currentLocation" ;
    rdfs:domain sc:Site ;
    rdfs:range sc:Resource .

