scadient:siteHasResource a owl:ObjectProperty ;
    rdfs:label "site has resource" ;
    rdfs:comment "Links a Site to the (container) Resources currently located at it, derived from the DPP currentLocation field" ;
    rdfs:domain sc:Site ;
    rdfs:range sc:Resource .

